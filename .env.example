# ===================================================
# LERNYXA LMS — Environment Configuration
# ===================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to source control.
# ===================================================

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_NAME=Lernyxa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Database (Local: Docker PostgreSQL)
# Production: Supabase Managed PostgreSQL
# ─────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=lernyxa
DB_USERNAME=lernyxa
DB_PASSWORD=lernyxa_secret

# ─────────────────────────────────────────────
# Redis (Cache, Sessions, Queues, Rate Limiting)
# ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ─────────────────────────────────────────────
# Session
# ─────────────────────────────────────────────
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ─────────────────────────────────────────────
# Mail (Local: Mailpit / Production: Resend)
# ─────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@lernyxa.com"
MAIL_FROM_NAME="Lernyxa"

# Production Resend config (uncomment for production):
# MAIL_MAILER=resend
# RESEND_API_KEY=re_your_api_key_here

# ─────────────────────────────────────────────
# Object Storage (Local: MinIO / Production: Supabase Storage)
# ─────────────────────────────────────────────
FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=lernyxa_minio
AWS_SECRET_ACCESS_KEY=lernyxa_minio_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=lernyxa
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://localhost:9000/lernyxa

# ─────────────────────────────────────────────
# Zoom Integration
# ─────────────────────────────────────────────
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# ─────────────────────────────────────────────
# Certificate & Security
# ─────────────────────────────────────────────
CERTIFICATE_VERIFICATION_BASE_URL=http://localhost:3000/verify
SIGNED_URL_EXPIRY_MINUTES=15

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─────────────────────────────────────────────
# Vite (Laravel asset bundling — not used in API-only mode)
# ─────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
